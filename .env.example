# Environment Variables

# MongoDB Connection String
# Get this from MongoDB Atlas or your MongoDB provider.
# A replica set (or Atlas) is REQUIRED for cross-record transactions
# (assignment, unassignment, transfers). Format:
# mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/vps-control?retryWrites=true&w=majority

# NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:2004

# Session cookie encryption (generate with: openssl rand -base64 32)
# Used for session cookies split across httpOnly/secure cookies (Phase B/C).
SESSION_SECRET=your-session-secret-here

# Encryption key for sensitive runtime data, e.g. password reset flows (Phase C).
# 32 bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=your-32-byte-base64-encryption-key

# VirtFusion API
VIRTFUSION_API_URL=https://your-virtfusion-instance.com/api/v1
VIRTFUSION_API_TOKEN=your-api-token-here

# Cron protection for automated sync jobs.
# The cron endpoint rejects requests unless they send Authorization: Bearer <this>.
CRON_SECRET=change-me

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set true only if SMTP_PORT is 465 (implicit TLS).
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# "From" address used for outgoing mail (defaults to SMTP_USER).
SMTP_FROM=your-email@gmail.com

# Application
NODE_ENV=development
PORT=2004