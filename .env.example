# Environment Variables

# MongoDB Connection String
# Get this from MongoDB Atlas or your MongoDB provider
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/vps-control?retryWrites=true&w=majority

# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:2004

# VirtFusion API
VIRTFUSION_API_URL=https://your-virtfusion-instance.com/api/v1
VIRTFUSION_API_TOKEN=your-api-token-here

# AWS Configuration (EC2 Cloud Instances)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Application
NODE_ENV=development
PORT=2004
